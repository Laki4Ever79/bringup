        "reason": "Brief: runs on one Li-ion cell, charged over USB-C (single-cell Li-ion linear charger)."
      },
      {
        "ref": "J1",
        "role": "usb-c",
        "mpn": "TYPE-C-31-M-12",
        "lcsc": "C165948",
        "footprint": "usbcmidmount",
