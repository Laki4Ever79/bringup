        "footprint": "dfn4",
        "pins": [
          "SDA",
          "SCL",
          "VDD",
          "VSS"
        ],
        "reason": "Brief: carries a temperature/humidity sensor. SHT40 has the tighter accuracy (±1.8 %RH, ±0.2 °C) on the board's I2C bus."
      },
      {
        "ref": "U3",
        "role": "ldo",
        "mpn": "RT9080-33GJ5",
        "lcsc": "C841192",
        "footprint": "sot23_5",
