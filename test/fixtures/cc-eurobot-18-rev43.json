    "parts": [
      {
        "ref": "U1",
        "role": "mcu",
        "mpn": "ESP32-C3-MINI-1",
        "lcsc": "C2838502",
        "footprint": "esp32_c3_mini_1",
        "pins": [
          "GPIO0",
          "GPIO1",
          "GPIO2",
          "GPIO3",
          "GPIO4",
          "GPIO5",
          "GPIO6",
          "GPIO7",
          "GPIO8",
          "GPIO9",
          "GPIO10",
          "GPIO18",
          "GPIO19",
          "EN",
          "3V3",
          "GND"
        ],
        "reason": "Brief: 'two driven wheels with encoders, odometry' and the firmware's BLE link. Its antenna goes on the edge opposite USB-C. Runs the motor driver, both encoders, the pull-cord START and the I2C distance sensor."
      },
      {
        "ref": "U3",
        "role": "ldo",
        "mpn": "RT9080-33GJ5",
        "lcsc": "C841192",
        "footprint": "sot23_5",
        "pins": [
          "VIN",
          "GND",
          "EN",
          "NC",
          "VOUT"
        ],
        "nets": {
          "VIN": "VIN_OR",
          "EN": "VIN_OR",
          "VOUT": "3V3"
        },
        "reason": "Makes the 3V3 rail (200 mA peak; the radio's transmit peak needs a 0.5 A supply) for the module, the encoders and the distance sensor, from VIN_OR (the cell through U8 or VBUS through D10). Rated 600 mA, 2 uA quiescent. Lifecycle to check before production (one LCSC page flags it)."
      },
      {
        "ref": "U8",
        "role": "ideal-diode",
        "mpn": "LM66100DCKR",
        "lcsc": "C2869734",
        "footprint": "sot363",
        "pins": [
          "VIN",
          "GND",
          "CE",
          "N/C",
          "ST",
          "VOUT"
        ],
        "nets": {
          "VIN": "VBAT",
          "CE": "VIN_OR",
          "VOUT": "VIN_OR"
        },
        "reason": "Brief: the cell (1S, 3.7 V) must power the 3V3 LDO. Ideal diode on the cell's path into U3 (OR-ed net VIN_OR). A Schottky's 0.3-0.6 V drop would leave the 3.3 V LDO out of regulation on a 3.7 V cell."
      },
      {
        "ref": "D10",
        "role": "diode",
        "mpn": "B5819W SL",
        "lcsc": "C8598",
        "footprint": "sod123",
        "pins": [
          "K",
          "A"
        ],
        "nets": {
          "A": "VBUS",
          "K": "VIN_OR"
        },
        "reason": "Schottky OR-ing USB VBUS into U3's input (net VIN_OR) beside the cell's ideal diode U8, so USB powers the board for programming when the cell is absent or flat."
      },
      {
        "ref": "J1",
        "role": "usb-c",
        "mpn": "TYPE-C-31-M-12",
        "lcsc": "C165948",
        "footprint": "usbcmidmount",
        "pins": [
          "VBUS",
          "GND",
          "CC1",
          "CC2",
          "DP",
          "DN"
        ],
        "reason": "Brief: 'one USB-C for programming'. Flashes the ESP32-C3 over its USB Serial/JTAG pins (GPIO18/GPIO19)."
      },
      {
        "ref": "J2",
        "role": "battery",
        "mpn": "S2B-PH-K-S(LF)(SN)",
        "lcsc": "C173752",
        "footprint": "jst2_ph",
        "pins": [
          "VBAT",
          "GND"
        ],
        "reason": "Brief: the cell (mechanics battery ADAFRUIT-2011, 1 cell 3.7 V) plugs in here. A 2-pin battery connector for the cell's VBAT and GND."
      },
      {
        "ref": "U5",
        "role": "motor-driver",
        "mpn": "DRV8833PWPR",
        "lcsc": "C50506",
        "footprint": "tssop16_w6.4mm_p0.65mm_thermalpad2.31mmx2.46mm",
        "pins": [
          "nSLEEP",
          "AOUT1",
          "AISEN",
          "AOUT2",
          "BOUT2",
          "BISEN",
          "BOUT1",
          "nFAULT",
          "BIN1",
          "BIN2",
          "VCP",
          "VM",
          "GND",
          "VINT",
          "AIN2",
          "AIN1"
        ],
        "reason": "Brief: 'motor driver' and 'two driven wheels'. Dual H-bridge for the two drive motors (0.67 A stall each), 1.5 A per bridge, rated for the cell's voltage."
      },
      {
        "ref": "JM1",
        "role": "connector",
        "mpn": "SM06B-SRSS-TB(LF)(SN)",
        "lcsc": "C160405",
        "footprint": "jst6_sh",
        "pins": [
          "GND",
          "ENCB",
          "ENCA",
          "VCC",
          "M2",
          "M1"
        ],
        "reason": "Brief: 'two driven wheels with encoders'. The left drive motor's two wires and its encoder (Pololu 5139) share this 6-pin plug; channel A goes to GPIO2 (ENC_LA)."
      },
      {
        "ref": "JM2",
        "role": "connector",
        "mpn": "SM06B-SRSS-TB(LF)(SN)",
        "lcsc": "C160405",
        "footprint": "jst6_sh",
        "pins": [
          "GND",
          "ENCB",
          "ENCA",
          "VCC",
          "M2",
          "M1"
        ],
        "reason": "Brief: 'two driven wheels with encoders'. The right drive motor's two wires and its encoder (Pololu 5139) share this 6-pin plug; channel A goes to GPIO10 (ENC_RA)."
      },
      {
        "ref": "JT1",
        "role": "connector",
        "mpn": "SM04B-SRSS-TB(LF)(SN)",
        "lcsc": "C160404",
        "footprint": "jst4_sh",
        "pins": [
          "GND",
          "VCC",
          "IO1",
          "IO2"
        ],
        "reason": "Brief: 'I2C distance sensor'. The VL53L0X's STEMMA QT cable plugs in here (GND, 3V3, SDA, SCL), per mechanics.sensor.connector JT1. The board's only I2C device, so SDA and SCL land on IO1 and IO2."
      },
      {
        "ref": "JE1",
        "role": "estop",
        "mpn": "B2B-XH-A(LF)(SN)",
        "lcsc": "C158012",
        "footprint": "pinrow2_p2.5_id1_od1.8",
        "pins": [
          "VBAT",
          "VM"
        ],
        "reason": "Brief: 'emergency stop' (mechanics.safety.estop JE1). The e-stop's normally closed contact sits between the cell and the driver's VM, so pressing it stops the motors."
      },
      {
        "ref": "JS1",
        "role": "start",
        "mpn": "PZ254V-11-02P",
        "lcsc": "C492401",
        "footprint": "pinrow2",
        "pins": [
          "START",
          "GND"
        ],
        "reason": "Brief: 'pull-cord start' (mechanics.safety.start JS1). The pull-cord plug the firmware reads on its START pin (GPIO3)."
      }
