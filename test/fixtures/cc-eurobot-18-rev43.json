  "values": {
    "requirements": {
      "summary": "Eurobot 2025/26 base robot: two driven wheels with quadrature encoders (channels A and B on both wheels), odometry (pose x, y, heading from the encoder counts) and go-to-point driving on the table. Acceptance: after a full lap of the table it ends within 2 cm of its start point. Pull-cord start, emergency stop, distance sensor for opponent detection, one USB-C for programming. No temperature/humidity payload: the board has no such sensor. Beacon mast, game mechanism and chassis belong to mechanics.",
      "peripherals": [
        "motor driver",
        "2 DC motors with quadrature encoders",
        "I2C distance sensor",
        "pull-cord start",
        "emergency stop"
      ],
