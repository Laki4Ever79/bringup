{
	"name": "bringup-mcp",
	"mcpName": "io.github.Laki4Ever79/bringup",
	"version": "0.2.1",
	"description": "Bringup: concurrent agents design a whole device or robot (board, printed parts, firmware, ROS) against one checked contract. MCP server: describe a device, change one thing, read the checks.",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"bringup-mcp": "bin/bringup-mcp.js"
	},
	"files": [
		"bin/",
		"src/",
		"!src/dashboard/**",
		"!src/demo.ts",
		"src/dashboard/ask.ts",
		"src/dashboard/assembly-geom.d.ts",
		"src/dashboard/assembly-geom.js",
		"src/dashboard/board-move.ts",
		"src/dashboard/board-view.ts",
		"src/dashboard/changelog.d.ts",
		"src/dashboard/changelog.js",
		"src/dashboard/lanes.d.ts",
		"src/dashboard/lanes.js",
		"src/dashboard/model.d.ts",
		"src/dashboard/model.js",
		"src/dashboard/progress.d.ts",
		"src/dashboard/progress.js",
		"src/dashboard/ripple.d.ts",
		"src/dashboard/ripple.js",
		"py/",
		"catalog/",
		"templates/",
		"briefs/",
		"examples/",
		"docker/",
		"docs/mcp.md",
		"server.json",
		"LICENSE",
		"NOTICE",
		"README.md",
		".env.example",
		"!**/__pycache__/",
		"!**/*.pyc",
		"!catalog/learned/",
		"!**/.cache/",
		"!**/.pio/"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Laki4Ever79/bringup.git"
	},
	"homepage": "https://github.com/Laki4Ever79/bringup#readme",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"hardware",
		"pcb",
		"robotics",
		"cad",
		"agents",
		"mozaik"
	],
	"scripts": {
		"start": "tsx src/main.ts",
		"typecheck": "tsc --noEmit",
		"test": "MOZAIK_CREDENTIALS_FILE=/dev/null MOZAIK_API_KEY= tsx --test test/*.test.ts",
		"bringup": "tsx src/main.ts",
		"tournament": "tsx src/tournament/cli.ts",
		"setup": "tsx src/setup/cli.ts setup",
		"doctor": "tsx src/setup/cli.ts doctor",
		"test:affected": "tsx scripts/test-affected.ts",
		"test:slow": "tsx scripts/test-slow.ts",
		"board": "MOZAIK_CREDENTIALS_FILE=/dev/null MOZAIK_API_KEY= PATH=$PWD/tools/node/node_modules/.bin:$PATH tsx scripts/board.ts",
		"experiment": "MOZAIK_CREDENTIALS_FILE=/dev/null MOZAIK_API_KEY= tsx src/experiment/cli.ts",
		"ros": "MOZAIK_CREDENTIALS_FILE=/dev/null MOZAIK_API_KEY= tsx src/ros/cli.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.74.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@mozaik-ai/cloud-sdk": "0.1.3",
		"@mozaik-ai/core": "4.1.0",
		"dotenv": "^17.4.2",
		"tsx": "^4.23.13",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"playwright": "1.65.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
