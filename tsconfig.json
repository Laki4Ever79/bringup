{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023"
		],
		"types": [
			"node"
		],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
