# One of these (Mozaik picks the provider from the model name)
OPENAI_API_KEY=
# Claude via the event gateway (build.jigjoy.ai/credits), opt-in with BRINGUP_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# GEMINI_API_KEY=
# Mozaik Cloud: set by `npx @mozaik-ai/cloud-sdk pair`, or paste a project key
# MOZAIK_API_KEY=
# Wokwi CI token (free at wokwi.com/dashboard/ci): firmware simulation with a virtual sensor. Optional
# WOKWI_CLI_TOKEN=
# Phone approvals through ntfy (docs/design/phone-approvals.md). Opt-in; ntfy.sh is public, so make the topic unguessable
# BRINGUP_NTFY_TOPIC=
# A self-hosted ntfy server instead of https://ntfy.sh
# BRINGUP_NTFY_SERVER=
