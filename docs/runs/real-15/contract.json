{
  "revision": 48,
  "values": {
    "requirements": {
      "summary": "Pocket-sized battery-powered climate logger with BLE phone access, USB-C charging and native USB-C firmware flashing using the ESP32-C3's USB pins, onboard storage of temperature/humidity history in the ESP32-C3's internal 4 MB flash, an MCU-driven status LED that blinks on each reading, and a dedicated hardware charge LED lit while charging from the charger's active-low CHRG output through a resistor.",
      "peripherals": [
        "Temperature/humidity sensor",
        "Bluetooth Low Energy",
        "USB-C charging",
        "USB-C firmware flashing over native USB",
        "Status LED",
        "Dedicated hardware charge LED",
        "Li-ion battery",
        "On-module flash history storage"
      ],
      "batteryLifeDays": 180,
      "batteryMah": 500,
      "dutyCycle": {
        "activeMs": 60,
        "periodS": 300,
        "sleepUa": 5
      },
      "sensor": {
        "mpn": "SHTC3-TR-2.5KS",
        "measures": [
          "temperature",
          "humidity"
        ],
        "accuracy": {
          "temperatureC": "typ ±0.2",
          "humidityRh": "typ ±2 %RH"
        },
        "notes": "Updated to SHTC3-TR-2.5KS due to SHT40 stockout. Power budget assumes the ESP32-C3 spends most of the time in deep sleep at the 5 µA floor, wakes every 5 minutes for a short sensor read and BLE beacon/connection window, uses brief LED pulses for status, and includes allowance for charger standby/leakage with no VBUS. The 180-day runtime target is based on usable battery capacity above regulator dropout rather than nominal cell capacity, using a low-dropout 3.3 V regulator so the MCU rail remains valid across most of the Li-ion discharge curve. Dedicated charge indication is hardware-driven from the charger's active-low CHRG output so it works while the MCU sleeps."
      }
    },
    "outline": {
      "widthMm": 40,
      "heightMm": 30,
      "thicknessMm": 1.6
    },
    "connectors": [
      {
        "ref": "J1",
