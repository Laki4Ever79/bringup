        "regulatorMaxMa": 500,
        "loadMa": 0,
        "averageMa": 0
      },
      {
        "name": "VBAT",
        "voltageV": 3.7,
        "regulatorMaxMa": 500,
        "loadMa": 500,
        "averageMa": 0.01,
        "notes": "Battery rail direct loads only: charger battery leakage / standby when USB is absent. Excludes current drawn by the 3V3 rail and excludes LDO quiescent current, which is checked separately."
      },
      {
        "name": "3V3",
        "voltageV": 3.3,
        "regulatorMaxMa": 200,
        "loadMa": 90,
        "averageMa": 0.054,
        "notes": "Battery-fed low-dropout rail for ESP32-C3, SHTC3, and MCU-driven status LED. Long-run average assumes deep sleep most of the time, a brief sensor/logging wake roughly every 300 s, and limited BLE advertising/user access windows. The selected low-Iq LDO maintains 3.3 V across most of the Li-ion discharge curve; average excludes regulator quiescent current."
      }
    ],
